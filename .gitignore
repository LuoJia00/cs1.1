# Private configuration, generated content and development caches.
**/__pycache__/
*.pyc
*.pyo
.env
.env.*
!.env.example
**/.DS_Store
**/Thumbs.db
**/node_modules/
**/.venv/
**/*.log
**/*.bak
**/auth.json
**/credentials.json
**/*.pem
**/*.key
!/python/Lib/site-packages/certifi/cacert.pem
!/python/Lib/site-packages/pip/_vendor/certifi/cacert.pem
